# ---------------------------------------------------------------------------
# ChessMood social analytics - example environment file
#
# HOW TO USE:
#   1. Copy this file and name the copy ".env"  (no ".example" on the end)
#   2. Fill in the real values after each "="
#   3. Never commit ".env" to git - .gitignore already blocks it
#
# Rules for this file format:
#   - No spaces around the "=" sign
#   - No quotes needed (and no trailing comments on the same line)
#   - Every value must be on ONE single line (important for the JSON below)
# ---------------------------------------------------------------------------


# --- Meta (Facebook + Instagram) --------------------------------------------

# Long-lived access token from the Meta Graph API.
# Needs these permissions: instagram_basic, instagram_manage_insights,
# pages_show_list, pages_read_engagement, read_insights
META_ACCESS_TOKEN=EAAG...replace_me

# Your Instagram *business* account ID (a long number, NOT your @handle).
# Find it with:
#   https://graph.facebook.com/v23.0/{FB_PAGE_ID}?fields=instagram_business_account&access_token={TOKEN}
IG_BUSINESS_ACCOUNT_ID=1784...replace_me

# Your Facebook Page ID (a long number, NOT the page name).
# Find it with:
#   https://graph.facebook.com/v23.0/me/accounts?access_token={TOKEN}
FB_PAGE_ID=1234...replace_me


# --- Google Sheets ----------------------------------------------------------

# The long ID in the middle of your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
GOOGLE_SHEET_ID=1AbC...replace_me

# The FULL contents of the service account JSON key file, as one single line.
# Two ways to produce a single line:
#   (a) Open the .json file, remove all the line breaks yourself, or
#   (b) Base64-encode the file and paste that instead - this script accepts both:
#       PowerShell:
#         [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json")) | Set-Clipboard
# For LOCAL testing only, you may also just put the file path here
# (e.g. C:\keys\key.json). GitHub Actions has no files, so use the JSON/base64.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","...":"..."}


# --- Optional settings (safe to leave out entirely) -------------------------

# Which Graph API version to call. See the WARNING in README.md - Meta retires
# old versions roughly every 2 years, so check this before your first run.
META_API_VERSION=v23.0

# How many days back to collect. Default 90.
LOOKBACK_DAYS=90

# Which Facebook edge to read posts from: published_posts (default) or posts.
FB_POSTS_EDGE=published_posts
